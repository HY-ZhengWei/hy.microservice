        <sql id="XSQL_Common_ProbeSchemaMeta_Query"> 
            
            <dataSourceGroup ref="DSG_MS_Common" />
            
            <content>
                <![CDATA[
                SELECT  A.id
                       ,A.schemaID
                       ,A.nameID
                       ,A.mname
                       ,A.mformat
                       ,A.mlength
                       ,A.mdecimal
                       ,A.pk
                       ,A.orderBy
                       ,A.projectID 
                       ,A.comment
                       ,A.isDel
                       ,A.createUserID
                       ,A.updateUserID
                       ,A.createTime
                       ,A.updateTime
                       ,B.id                AS "items.id"
                       ,(
                         SELECT  COUNT(1)
                           FROM  TFavoriteData  SA 
                          WHERE  SA.updateUserID = ':userID'
                            AND  SA.serviceType  = 'ProbeSchemaMeta'
                            AND  SA.dataID       = A.id
                            AND  SA.isDel        = 0
                        )    AS  isFavorite
                  FROM  TProbeSchemaMeta  A
                 WHERE  A.isDel         = 0
              <[   AND  A.id            = ':id'           ]>
              <[   AND  A.schemaID      = ':schemaID'     ]>
              <[   AND  A.nameID        = ':nameID'       ]>
              <[   AND  A.mname         = ':mname'        ]>
              <[   AND  A.mformat       = ':mformat'      ]>
              <[   AND  A.mlength       = ':mlength'      ]>
              <[   AND  A.mdecimal      = ':mdecimal'     ]>
              <[   AND  A.pk            = ':pk'           ]>
              <[   AND  A.projectID     = ':projectID'    ]>
              <[   AND  (
                         SELECT  COUNT(1)
                           FROM  TFavoriteData  SA 
                          WHERE  SA.updateUserID = ':userID'
                            AND  SA.serviceType  = 'ProbeSchemaMeta'
                            AND  SA.dataID       = A.id
                            AND  SA.isDel        = 0
                        ) >= :isFavorite                  ]>
                 ORDER  BY A.updateTime DESC
                ]]>
            </content>
            
