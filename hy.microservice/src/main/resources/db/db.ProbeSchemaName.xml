        <sql id="XSQL_Common_ProbeSchemaName_Query"> 
            
            <dataSourceGroup ref="DSG_MS_Common" />
            
            <content>
                <![CDATA[
                SELECT  B.id
                       ,B.schemaID
                       ,B.tableName
                       ,B.metaCode
                       ,B.projectID 
                       ,B.comment
                       ,B.isDel
                       ,B.createUserID
                       ,B.updateUserID
                       ,B.createTime
                       ,B.updateTime
                       ,C.id            AS "metas.id"            
                       ,C.schemaID      AS "metas.schemaID"
                       ,C.nameID        AS "metas.nameID"
                       ,C.mname         AS "metas.mname"
                       ,C.mformat       AS "metas.mformat"
                       ,C.mlength       AS "metas.mlength"
                       ,C.mdecimal      AS "metas.mdecimal"
                       ,C.pk            AS "metas.pk"
                       ,C.orderBy       AS "metas.orderBy"
                       ,C.projectID     AS "metas.projectID"
                       ,C.comment       AS "metas.comment"
                       ,C.isDel         AS "metas.isDel"
                       ,C.createUserID  AS "metas.createUserID"
                       ,C.updateUserID  AS "metas.updateUserID"
                       ,C.createTime    AS "metas.createTime"
                       ,C.updateTime    AS "metas.updateTime"
                       ,(
                         SELECT  COUNT(1)
                           FROM  TFavoriteData  SA 
                          WHERE  SA.updateUserID = ':userID'
                            AND  SA.serviceType  = 'ProbeSchemaName'
                            AND  SA.dataID       = B.id
                            AND  SA.isDel        = 0
                        )    AS  isFavorite
                  FROM  TProbeSchemaName  B
                       ,TProbeSchemaMeta  C
                 WHERE  B.schemaID      = C.schemaID
                   AND  B.id            = C.nameID
                   AND  B.isDel         = 0
                   AND  C.isDel         = 0
              <[   AND  B.id            = ':id'           ]>
              <[   AND  B.schemaID      = ':schemaID'     ]>
              <[   AND  B.tableName     = ':tableName'    ]>
              <[   AND  B.metaCode      = ':metaCode'     ]>
              <[   AND  B.projectID     = ':projectID'    ]>
              <[   AND  (
                         SELECT  COUNT(1)
                           FROM  TFavoriteData  SA 
                          WHERE  SA.updateUserID = ':userID'
                            AND  SA.serviceType  = 'ProbeSchemaName'
                            AND  SA.dataID       = B.id
                            AND  SA.isDel        = 0
                        ) >= :isFavorite                  ]>
                 ORDER  BY B.updateTime DESC
                          ,C.orderBy
                ]]>
            </content>
            
