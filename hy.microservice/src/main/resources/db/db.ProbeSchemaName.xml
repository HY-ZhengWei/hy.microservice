        <!-- 逻辑删除也是被禁止的，仅允许修改非关键信息，其它信息添加后就不能修改 -->
        <sql id="XSQL_Common_ProbeSchemaName_Update"> 
        
            <dataSourceGroup ref="DSG_MS_Common" />
            
            <content if="DAMENG == this.getDataSourceGroup.getDbProductType">
                <![CDATA[
                UPDATE  TProbeSchemaName
                   SET  updateTime   = SYSDATE
                       ,updateUserID = ':Schema.name.updateUserID'
                    <[ ,projectID    = ':Schema.name.projectID'    ]>
                    <[ ,"COMMENT"    = ':Schema.name.comment'      ]>
                 WHERE  id           = ':Schema.name.id'
                ]]>
            </content>
            
