            <content if="ORACLE == this.getDataSourceGroup.getDbProductType">
                <![CDATA[
                SELECT  A.id
                       ,A.type
                       ,A.nameID
                       ,A.projectID 
                       ,A."COMMENT"
                       ,A.isDel
                       ,A.createUserID
                       ,A.updateUserID
