              <[   AND  A.id            = ':id'           ]>
              <[   AND  A.type          = ':type'         ]>
              <[   AND  A.nameID        = ':nameID'       ]>
              <[   AND  A.projectID     = ':projectID'    ]>
              <[   AND  (
                         SELECT  COUNT(1)
