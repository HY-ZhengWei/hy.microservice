        <sql id="XSQL_Common_ProbeSchema_Query"> 
            
            <dataSourceGroup ref="DSG_MS_Common" />
            
            <content>
                <![CDATA[
                SELECT  A.id
                       ,A.type
                       ,A.nameID
                       ,A.projectID 
                       ,A.comment
                       ,A.isDel
                       ,A.createUserID
                       ,A.updateUserID
                       ,A.createTime
                       ,A.updateTime
                       ,B.id            AS "name.id"
                       ,B.schemaID      AS "name.schemaID"
                       ,B.tableName     AS "name.tableName"
                       ,B.metaCode      AS "name.metaCode"
                       ,B.projectID     AS "name.projectID"
                       ,B.comment       AS "name.comment"
                       ,B.isDel         AS "name.isDel"
                       ,B.createUserID  AS "name.createUserID"
                       ,B.updateUserID  AS "name.updateUserID"
                       ,B.createTime    AS "name.createTime"
                       ,B.updateTime    AS "name.updateTime"
                       ,C.id            AS "metas.id"            
                       ,C.schemaID      AS "metas.schemaID"
                       ,C.nameID        AS "metas.nameID"
                       ,C.mname         AS "metas.mname"
                       ,C.mformat       AS "metas.mformat"
                       ,C.mlength       AS "metas.mlength"
                       ,C.mdecimal      AS "metas.mdecimal"
                       ,C.pk            AS "metas.pk"
                       ,C.orderBy       AS "metas.orderBy"
                       ,C.projectID     AS "metas.projectID"
                       ,C.comment       AS "metas.comment"
                       ,C.isDel         AS "metas.isDel"
                       ,C.createUserID  AS "metas.createUserID"
                       ,C.updateUserID  AS "metas.updateUserID"
                       ,C.createTime    AS "metas.createTime"
                       ,C.updateTime    AS "metas.updateTime"
                       ,(
                         SELECT  COUNT(1)
                           FROM  TFavoriteData  SA 
                          WHERE  SA.updateUserID = ':userID'
                            AND  SA.serviceType  = 'ProbeSchema'
                            AND  SA.dataID       = A.id
                            AND  SA.isDel        = 0
                        )    AS  isFavorite
                  FROM  TProbeSchema      A
                       ,TProbeSchemaName  B
                       ,TProbeSchemaMeta  C
                 WHERE  A.id            = B.schemaID
                   AND  A.nameID        = B.id
                   AND  B.id            = C.nameID
                   AND  B.schemaID      = C.schemaID
                   AND  C.isDel         = 0
                   AND  B.isDel         = 0
                   AND  A.isDel         = 0
              <[   AND  A.id            = ':id'           ]>
              <[   AND  A.type          = ':type'         ]>
              <[   AND  A.nameID        = ':nameID'       ]>
              <[   AND  A.projectID     = ':projectID'    ]>
              <[   AND  (
                         SELECT  COUNT(1)
                           FROM  TFavoriteData  SA 
                          WHERE  SA.updateUserID = ':userID'
                            AND  SA.serviceType  = 'ProbeSchema'
                            AND  SA.dataID       = A.id
                            AND  SA.isDel        = 0
                        ) >= :isFavorite                  ]>
                 ORDER  BY A.updateTime DESC
                          ,C.orderBy
                ]]>
            </content>
            
