                <![CDATA[
                UPDATE  TProbeSchema
                   SET  updateTime   = SYSDATE
                       ,updateUserID = ':Schema.updateUserID'
                    <[ ,nameID       = ':Schema.nameID'       ]>
                    <[ ,projectID    = ':Schema.projectID'    ]>
