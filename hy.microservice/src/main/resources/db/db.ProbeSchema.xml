                            AND  SA.isDel        = 0
                        )    AS  isFavorite
                  FROM  TProbeSchema      A
                       ,TProbeSchemaName  B
                       ,TProbeSchemaMeta  C
                 WHERE  A.id            = B.schemaID
                   AND  A.nameID        = B.id
                   AND  B.id            = C.nameID
                   AND  B.schemaID      = C.schemaID
                   AND  C.isDel         = 0
                   AND  B.isDel         = 0
                   AND  A.isDel         = 0
              <[   AND  A.id            = ':id'           ]>
              <[   AND  A.type          = ':type'         ]>
              <[   AND  A.nameID        = ':nameID'       ]>
              <[   AND  A.projectID     = ':projectID'    ]>
              <[   AND  (
                         SELECT  COUNT(1)
                           FROM  TFavoriteData  SA 
                          WHERE  SA.updateUserID = ':userID'
                            AND  SA.serviceType  = 'ProbeSchema'
                            AND  SA.dataID       = A.id
                            AND  SA.isDel        = 0
                        ) >= :isFavorite                  ]>
                 ORDER  BY A.updateTime DESC
                          ,C.orderBy
                ]]>
            </content>
            
            <result>
                <table>java.util.LinkedHashMap</table>
                <fill>put(row.id ,row)</fill>
                <row>org.hy.microservice.common.probe.schema.ProbeSchema</row>
                <cfill>setter(colValue)</cfill>
                <relationKeys>id</relationKeys>
            </result>
            
        </sql>
        
        
        
