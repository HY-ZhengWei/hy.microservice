<?xml version="1.0" encoding="UTF-8"?>

<config>

    <import name="sqls"            class="java.util.ArrayList" />
    <import name="sqlGroup"        class="org.hy.common.xml.plugins.XSQLGroup" />
    <import name="sql"             class="org.hy.common.xml.XSQL" />



    <!-- 数据探针的原数据的相关SQL组 -->
    <sqls>
        
        <sqlGroup id="GXSQL_Common_ProbeData_Save">
            <comment>保存数据探针的原数据</comment>
            
            <sqlNode>
                <sql  ref="XSQL_Common_ProbeData_IsExists" />
                <type ref="this.$Type_Query" />
                <oneConnection>true</oneConnection>
            </sqlNode>
            
            <sqlNode>
                <sql  ref="XSQL_Common_ProbeData_Insert" />
                <type ref="this.$Type_ExecuteUpdate" />
                <condition><![CDATA[:ProbeData_IsExists <= 0 && :isDel == 0]]></condition>
            </sqlNode>
            
            <sqlNode>
                <sql  ref="XSQL_Common_ProbeData_Update" />
                <type ref="this.$Type_ExecuteUpdate" />
                <condition><![CDATA[:ProbeData_IsExists >= 1]]></condition>
            </sqlNode>
        </sqlGroup>
        
    </sqls>
    
</config>