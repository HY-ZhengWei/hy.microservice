<?xml version="1.0" encoding="UTF-8"?>

<config>

    <import name="xcallFlow" class="org.hy.common.callflow.common.CallFlowImports" />
    
    
    
    <!-- CFlow编排引擎配置：数据探针的向云端同步数据 -->
    <xconfig>
    
        <xapi id="XCFlow_Common_ProbeData_Sync">
            <comment>数据探针的向云端同步数据</comment>
            <url>http://127.0.0.1:8080/hy.microservice/probe/data</url>
            <body>:RequestBody</body>
            <showLog>true</showLog>
            <succeedFlag>"code":"200"</succeedFlag>
            <returnClass>org.hy.microservice.common.probe.ProbeResponseVO</returnClass>
            <returnID>ProbeResponse</returnID>
        </xapi>
        
    </xconfig>
    
</config>